# PPIO Sandbox platform key (template build + sandbox lifecycle)
PPIO_API_KEY=

# Kimi application key (sk-...): manages agents, environments, sessions and
# reads the event stream. Stays in your application. Never enters the sandbox.
KIMI_API_KEY=

# Self-hosted environment the worker serves. Create it once:
#   npm run webhook:client -- --create-environment <name>
# or POST /v1/environments with {"config":{"type":"self_hosted"}}.
KIMI_ENVIRONMENT_ID=

# Environment work key (ewk-...), generated on that environment's Worker tab
# in the console. Shown once. This is the only credential that enters the
# sandbox, passed to `kha worker poll` over stdin. It can only claim work
# from this one environment and nothing else.
KIMI_ENVIRONMENT_KEY=

# Agent the sessions run. Sessions need an existing agent; create one with
#   npm run webhook:client -- --create-agent <name>
# Optional for `example` and `e2e`, which create a throwaway agent if unset.
KIMI_AGENT_ID=

# Hosted Agents endpoint. Only api.moonshot.cn serves it. Set this explicitly
# if your shell exports a different base URL for a local LLM gateway — the
# gateway has no /v1/sessions route.
KIMI_BASE_URL=https://api.moonshot.cn

# PPIO region. The SDK derives its API endpoint from this, and an API key is
# only valid against its own region. This project defaults to the Beijing
# region when unset; set it explicitly if your key lives elsewhere. Forwarded
# to the controller by `webhook:deploy`, which creates worker sandboxes with
# the same SDK.
# PPIO_DOMAIN=cn-beijing-1.sandbox.ppio.com

# Optional overrides
# PPIO_TEMPLATE_NAME=kimi-agents-api-executor
# PPIO_BUILD_TAG=
# HTTP proxy for downloads during `npm run build:template` only (apt-get and the
# kha installer). Build-time ENV; never reaches the sandbox runtime.
# PPIO_BUILD_PROXY=http://10.97.197.11:1081
# AGENTS_MODEL=kimi-k3.1-pro
